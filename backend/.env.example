# MongoDB connection string. Provided by you - never commit the real one.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=memorybridge

# Optional: only used for local backend-side testing / smoke tests.
# In the real flow the Flutter app sends the user's key per-request.
GEMINI_API_KEY=
# Flash tier only, by design - keeps per-call cost down. Confirmed available
# via scripts/check_gemini_models.py; gemini-2.0-flash has been retired.
GEMINI_MODEL=gemini-2.5-flash

# ASR provider: "stub" | "provided"
# "stub"     -> reads a sidecar <audio>.txt transcript (no speech recognition -
#               a stand-in for demoing the pipeline without real audio)
# "provided" -> app/speech2text.py (faster-whisper, offline, no API key)
ASR_PROVIDER=provided

# app/speech2text.py config - all optional, sane defaults if unset.
# STT_MODEL: tiny | base | small | medium | large-v3 | distil-large-v3
STT_MODEL=base
# STT_DEVICE: cpu | cuda (default: auto-detected)
# STT_DEVICE=
# STT_LANGUAGE: e.g. en, hi (default: auto-detected per file)
# STT_LANGUAGE=
# STT_CACHE_DIR: where model weights are downloaded/cached (default: HF cache)
# STT_CACHE_DIR=

# Where uploaded audio is kept during processing
UPLOAD_DIR=./uploads

# --- Actian VectorAI DB (semantic memory layer) -----------------------------
# Runs in Docker; see README. Start it with:
#   docker run -d --name vectorai -v "${PWD}\local_data:/var/lib/actian-vectorai" \
#     -p 6573-6575:6573-6575 -e "ACTIAN_VECTORAI_ACCEPT_EULA=YES" actian/vectorai:latest
# Set VECTOR_DB_ENABLED=false to turn the layer off entirely; retrieval then
# falls back to MongoDB, which is also what happens if the container is down.
VECTOR_DB_ENABLED=true
VECTOR_DB_URL=localhost:6574
VECTOR_DB_COLLECTION=memorybridge_memories
# Only needed if the server has auth enabled (it is off by default).
# VECTOR_DB_API_KEY=
# VECTOR_DB_TIMEOUT=15

# How many memories retrieval pulls back, per question and per call briefing.
# VECTOR_SEARCH_LIMIT=24
# VECTOR_BRIEFING_LIMIT=40

# Embeddings reuse the Gemini key above - no second credential, no local model.
# EMBEDDING_DIM must match the collection's dimension; changing either one
# means recreating the collection (scripts/reindex_vectordb.py --recreate).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
