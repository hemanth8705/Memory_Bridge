# MongoDB connection string. Provided by you - never commit the real one.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=memorybridge

# Optional: only used for local backend-side testing / smoke tests.
# In the real flow the Flutter app sends the user's key per-request.
GEMINI_API_KEY=

# ASR provider: "stub" | "provided"
# "stub"     -> reads a sidecar <audio>.txt transcript (lets the pipeline run today)
# "provided" -> your ASR implementation, dropped into app/asr_provided.py
ASR_PROVIDER=stub

# Where uploaded audio is kept during processing
UPLOAD_DIR=./uploads
